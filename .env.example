# HIERLINK ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this to .env and fill in your real keys for production.
# DO NOT COMMIT THE ACTUAL .env FILE!

# 1. Core Config
PORT=8501
PYTHONUNBUFFERED=1

# 2. Database (Development: sqlite, Production: postgresql://...)
# If using Render PostgreSQL, Render will provide this URL automatically.
DATABASE_URL=sqlite:///./data/sqlite/local.db

# 3. AI Intelligence (Gemini AI)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Payments (Razorpay) - Optional
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# 5. Security (Optional)
# SECRET_KEY=generate_a_random_string_for_flask_sessions

# 6. Email Notifications (Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
